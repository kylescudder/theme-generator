{
    admin off
    auto_https off
    persist_config off
}
:8080 {
    encode zstd gzip
    header {
        X-Theme-Generator-Revision {$THEME_GENERATOR_REVISION}
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    handle /healthz {
        header Cache-Control no-store
        header Content-Type application/json
        respond `{"ok":true,"revision":"{$THEME_GENERATOR_REVISION}"}` 200
    }
    handle {
        root * /srv
        header /_astro/* Cache-Control "public, max-age=31536000, immutable"
        try_files {path} {path}.html {path}/
        file_server
    }
    handle_errors 404 {
        root * /srv
        rewrite * /404.html
        file_server
    }
}
